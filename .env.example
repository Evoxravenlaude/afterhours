# live | replay
MODE=live
PORT=8787
# On Railway, mount a volume at /data and use /data/afterhours.db so alerts and scores survive redeploys
DB_PATH=data/afterhours.db
PUBLIC_URL=https://your-app.up.railway.app
# Optional: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Optional: your own BSC RPC (defaults to the public BNB Chain endpoint)
BSC_RPC_URL=
# Token list types to query from the Binance RWA list endpoint ("none" = no filter)
TOKEN_TYPES=none,1,2,3
# Optional: limit to these tickers (default: every ticker with a liquid Hyperliquid perp)
TICKERS=
# Model knobs. Leave unset to use the backtested defaults (EXTERNAL_WEIGHT=1, MIN_NET_EDGE=0.005); see docs/SCORECARD.md
# EXTERNAL_WEIGHT=
# MIN_NET_EDGE=
TICK_MS=60000
